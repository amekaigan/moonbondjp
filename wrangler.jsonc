{
  "name": "moonbondjp",
  "compatibility_date": "2025-11-01",
  // 支払いの確認と、くわしい鑑定ページの鍵を担当する（worker.js）
  "main": "worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/full", "/full/", "/full/index.html", "/me", "/me/", "/me/index.html"]
  }
  // PayPal の Client ID と Secret は、Cloudflare の「変数とシークレット」に PAYPAL_CLIENT_ID・PAYPAL_SECRET（どちらも種類はシークレット）として入れる。
  // ここに vars を書くと、公開のたびに画面で入れた値が消えるので書かない
}
